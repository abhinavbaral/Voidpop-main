# Copy to .env (or set these in your host's dashboard). Nothing here is needed to try it locally.
PORT=8787
# REQUIRED in production: a long random string (e.g. `openssl rand -hex 32`). Signs login tokens.
# If it is unset, a temporary one is made at start-up and everyone is signed out on every restart.
VOIDPOP_SECRET=
# Where the database file lives (default: server/data/voidpop.db). ":memory:" for throwaway.
VOIDPOP_DB=
# Websites allowed to call the API, comma separated. Default: any (the API uses a bearer token, not cookies).
VOIDPOP_ORIGINS=
# Set to 1 only behind a reverse proxy you control, so rate limits use X-Forwarded-For.
TRUST_PROXY=
