{
  "expo": {
    "name": "Voidation",
    "slug": "voidation",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b0f19",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b0f19"
    },
    "android": {
      "package": "com.voidation.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b0f19"
      },
      "blockedPermissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "voidation"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.voidation.app"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#a855f7"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "NextEpisodes",
              "label": "Voidation · Next episodes",
              "description": "Countdowns for up to 30 anime you follow",
              "minWidth": "250dp",
              "minHeight": "180dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "maxResizeHeight": "600dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widget-preview.png"
            }
          ]
        }
      ],
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Voidmon",
            "ios": "./assets/app-icons/voidmon-ios.png",
            "android": {
              "foregroundImage": "./assets/app-icons/voidmon-foreground.png",
              "backgroundColor": "#0b0f19"
            }
          },
          {
            "name": "Peeking",
            "ios": "./assets/app-icons/peeking-ios.png",
            "android": {
              "foregroundImage": "./assets/app-icons/peeking-foreground.png",
              "backgroundColor": "#0b0f19"
            }
          }
        ]
      ]
    ],
    "scheme": "voidation",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/60c0d3f0-5f80-4f55-b21e-9d32892e270f",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "owner": "abhinavbaral",
    "extra": {
      "eas": {
        "projectId": "60c0d3f0-5f80-4f55-b21e-9d32892e270f"
      }
    },
    "platforms": [
      "android",
      "ios"
    ]
  }
}
