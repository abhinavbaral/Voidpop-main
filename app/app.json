{
  "expo": {
    "name": "Voidation",
    "slug": "voidation",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b0f19",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b0f19"
    },
    "android": {
      "package": "com.voidation.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b0f19"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.voidation.app"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#a855f7"
        }
      ]
    ]
  }
}
