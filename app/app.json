{
  "expo": {
    "name": "Voidation",
    "slug": "voidation",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b0f19",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b0f19"
    },
    "android": {
      "package": "com.voidation.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b0f19"
      },
      "blockedPermissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.voidation.app"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#a855f7"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "NextEpisodes",
              "label": "Voidation \u00b7 Next episodes",
              "description": "Countdowns for up to 30 anime you follow",
              "minWidth": "250dp",
              "minHeight": "180dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "maxResizeHeight": "600dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widget-preview.png"
            }
          ]
        }
      ]
    ],
    "scheme": "voidation"
  }
}
