# Copy this file to app/.env (it is git-ignored) and fill it in. These are read when you run `eas update` or `eas build`:
# change one, then run the command again.

# Where the VoidPop server lives, with no trailing slash. Without it the app has no accounts: the Login screen says so,
# and only Guest mode works. Must be https:// for a release APK (Android refuses plain http). See server/README.md.
EXPO_PUBLIC_VOIDPOP_API=

# The WEB OAuth client id from Google Cloud Console (the same one the server has as GOOGLE_CLIENT_IDS). Leave empty
# until Google login is set up: the Google button then says it isn't set up yet.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
